{
  "name": "capybazaar",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:contracts": "bash contracts/build.sh",
    "town": "tsx packages/scripts/src/setup.ts",
    "dev": "concurrently -k -n onboard,keeper,bots,web -c yellow,cyan,magenta,green \"pnpm onboard\" \"pnpm keeper\" \"pnpm bots\" \"pnpm web\"",
    "onboard": "tsx packages/scripts/src/server.ts",
    "keeper": "tsx packages/scripts/src/keeper.ts",
    "bots": "tsx packages/scripts/src/bots.ts",
    "web": "pnpm --filter @capy/web dev",
    "sim": "tsx packages/scripts/src/sim.ts",
    "demo": "tsx packages/scripts/src/demo.ts",
    "test": "pnpm --filter @capy/core test && cargo test --manifest-path contracts/Cargo.toml",
    "typecheck": "pnpm -r typecheck",
    "config-town": "tsx packages/scripts/src/config.ts",
    "measure": "tsx packages/scripts/src/measure.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "concurrently": "10.0.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
